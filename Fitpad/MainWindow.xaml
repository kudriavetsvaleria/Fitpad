<Window x:Class="Fitpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fitpad.Converters"
        Title="Fitpad" Height="700" Width="1018">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:WidthConverter x:Key="WidthConverter" />
        <local:ButtonWidthConverter x:Key="ButtonWidthConverter" />
        <local:ButtonContentConverter x:Key="ButtonContentConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsNavigationExpanded, Converter={StaticResource WidthConverter}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель навигации -->
        <StackPanel Grid.Column="0" Background="#FFDDDDDD" >

            <!-- Основные кнопки навигации с изменением контента и ширины -->

            <!-- Основные кнопки навигации с изменением контента и ширины -->
            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=Новини, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowNewsCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5,20,5,5"/>

            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=Збережене, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowFavoritesCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=Харчування, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowNutritionCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=Калории, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowCaloriesCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />


            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=Тренування, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowWorkoutsCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=Профіль, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowProfileCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />


            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=AccountLogin, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowAccountLoginCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, ConverterParameter=AccountRegistration, Converter={StaticResource ButtonContentConverter}}"
                    Command="{Binding ShowAccountRegistrationCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />
        </StackPanel>

        <!-- Кнопка для скрытия/развёртывания панели -->
        <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Toggle'}"
                    Command="{Binding ToggleNavigationCommand}"
                    Width="50" Height="50" HorizontalAlignment="Right" Margin="0,600,5,0" />

        <!-- Контентная область -->
        <Frame Grid.Column="1" Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
