<Window x:Class="Fitpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fitpad.Converters"
        Title="Fitpad" Height="600" Width="950">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:WidthConverter x:Key="WidthConverter" />
        <local:ButtonWidthConverter x:Key="ButtonWidthConverter" />
        <local:ButtonContentConverter x:Key="ButtonContentConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Применяем конвертер для изменения ширины панели -->
            <ColumnDefinition Width="{Binding IsNavigationExpanded, Converter={StaticResource WidthConverter}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель навигации -->
        <StackPanel Grid.Column="0" Background="#FFDDDDDD" >
            <!-- Кнопка для скрытия/развёртывания панели -->
            <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Toggle'}"
                    Command="{Binding ToggleNavigationCommand}"
                    Width="50" Height="50" HorizontalAlignment="Right" Margin="0,5,5,0" />

            <!-- Основные кнопки навигации с изменением контента и ширины -->
            <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Новини'}"
                    Command="{Binding ShowNewsCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Збережене'}"
                    Command="{Binding ShowFavoritesCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Харчування'}"
                    Command="{Binding ShowNutritionCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Тренування'}"
                    Command="{Binding ShowWorkoutsCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />

            <Button Content="{Binding IsNavigationExpanded, Converter={StaticResource ButtonContentConverter}, ConverterParameter='Профіль'}"
                    Command="{Binding ShowProfileCommand}"
                    Width="{Binding IsNavigationExpanded, Converter={StaticResource ButtonWidthConverter}}"
                    Height="50"
                    Margin="5" />
        </StackPanel>

        <!-- Контентная область -->
        <Frame Grid.Column="1" Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
