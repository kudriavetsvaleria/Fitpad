<Page x:Class="Fitpad.View.Pages.CaloriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
	<Grid>
		<StackPanel Margin="20">
			<!-- Ввод данных -->
			<TextBlock Text="Вес (кг):" Margin="0,10,0,5" />
			<TextBox x:Name="WeightInput" Width="200" />

			<TextBlock Text="Рост (см):" Margin="0,10,0,5" />
			<TextBox x:Name="HeightInput" Width="200" />

			<TextBlock Text="Возраст:" Margin="0,10,0,5" />
			<TextBox x:Name="AgeInput" Width="200" />

			<TextBlock Text="Пол:" Margin="0,10,0,5" />
			<ComboBox x:Name="GenderInput" Width="200">
				<ComboBoxItem Content="Мужчина" />
				<ComboBoxItem Content="Женщина" />
			</ComboBox>

			<TextBlock Text="Уровень активности:" Margin="0,10,0,5" />
			<TextBox x:Name="ActivityLevelInput" Width="200" />

			<!-- Кнопка рассчета -->
			<Button Content="Рассчитать" Click="CalculateButton_Click" Width="200" Margin="0,20,0,0" />

			<!-- Результаты -->
			<TextBlock Text="Результаты:" FontWeight="Bold" Margin="0,20,0,5" />
			<TextBlock Text="{Binding CaloriesData.Calories, StringFormat='Калории: {0:F2}'}" />
			<TextBlock Text="{Binding CaloriesData.Protein, StringFormat='Белки: {0:F2} г'}" />
			<TextBlock Text="{Binding CaloriesData.Fats, StringFormat='Жиры: {0:F2} г'}" />
			<TextBlock Text="{Binding CaloriesData.Carbs, StringFormat='Углеводы: {0:F2} г'}" />
		</StackPanel>
	</Grid>
</Page>
