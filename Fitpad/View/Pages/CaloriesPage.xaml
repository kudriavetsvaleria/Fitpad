<Page x:Class="Fitpad.View.Pages.CaloriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ввод данных пользователя">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Шаг 1: Пол -->
            <StackPanel x:Name="Step1" Visibility="Visible">
                <Label Content="Выберите ваш пол:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <ComboBox x:Name="GenderInput" Width="250" Height="30" FontSize="14" Margin="0,0,0,10">
                    <ComboBoxItem Content="Мужской"/>
                    <ComboBoxItem Content="Женский"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Далее" Width="120" Height="35" Click="NextStep_Click" Tag="2"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 2: Возраст -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <Label Content="Введите ваш возраст:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="AgeInput" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Назад" Width="120" Height="35" Click="PreviousStep_Click" Tag="1"
                            Background="#D9534F" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Далее" Width="120" Height="35" Click="NextStep_Click" Tag="3"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 3: Рост -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <Label Content="Введите ваш рост (см):" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="HeightInput" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Назад" Width="120" Height="35" Click="PreviousStep_Click" Tag="2"
                            Background="#D9534F" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Далее" Width="120" Height="35" Click="NextStep_Click" Tag="4"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 4: Вес -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <Label Content="Введите ваш вес (кг):" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="WeightInput" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Назад" Width="120" Height="35" Click="PreviousStep_Click" Tag="3"
                            Background="#D9534F" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Далее" Width="120" Height="35" Click="NextStep_Click" Tag="5"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 5: Уровень активности -->
            <StackPanel x:Name="Step5" Visibility="Collapsed">
                <Label Content="Выберите уровень вашей активности:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <ComboBox x:Name="ActivityLevelInput" Width="250" Height="30" FontSize="14" Margin="0,0,0,10">
                    <ComboBoxItem Content="Низкая"/>
                    <ComboBoxItem Content="Средняя"/>
                    <ComboBoxItem Content="Высокая"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Назад" Width="120" Height="35" Click="PreviousStep_Click" Tag="4"
                            Background="#D9534F" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Сохранить" Width="120" Height="35" Click="SaveButton_Click"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Текст ошибки -->
            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextAlignment="Center" Visibility="Collapsed" 
                       Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
