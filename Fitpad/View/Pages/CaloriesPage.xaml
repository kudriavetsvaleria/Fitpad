<Page x:Class="Fitpad.View.Pages.CaloriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Fitpad.View.Components"
      Title="Ввод данных пользователя">

    <!-- Оборачиваем весь контент в ScrollViewer -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <!-- Дата и день недели -->
            <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14"
                       FontWeight="Bold" Margin="0,10,10,0" Visibility="Collapsed"/>

            <!-- Основной контент -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">

                <!-- Суточная норма калорий -->
                <TextBlock x:Name="CalorieTextBlock" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Visibility="Collapsed"/>

                <!-- Блок КБЖУ -->
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="КБЖУ:" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
                    <TextBlock x:Name="ProteinTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="FatTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="CarbTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>
                
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Питьевой режим:" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
                    <TextBlock x:Name="WaterTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Блок клетчатки, сахара и соли -->
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Клетчатка, сахар и соль:" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
                    <TextBlock x:Name="FiberTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SugarTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SaltTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="Рацион за день:" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>

                    <!-- Блок для отображения введенных блюд -->
                    <StackPanel x:Name="MealsPanel" Margin="0,10,0,0">
                        <TextBlock Text="Завтрак (06:00 - 09:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="BreakfastTextBlock" Text="-" Margin="10,5,0,10"/>

                        <TextBlock Text="Второй завтрак (09:00 - 11:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SecondBreakfastTextBlock" Text="-" Margin="10,5,0,10"/>

                        <TextBlock Text="Обед (12:00 - 14:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="LunchTextBlock" Text="-" Margin="10,5,0,10"/>

                        <TextBlock Text="Полдник (15:00 - 16:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="AfternoonSnackTextBlock" Text="-" Margin="10,5,0,10"/>

                        <TextBlock Text="Ужин (18:00 - 20:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="DinnerTextBlock" Text="-" Margin="10,5,0,10"/>

                        <TextBlock Text="Второй ужин (20:00 - 22:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SecondDinnerTextBlock" Text="-" Margin="10,5,0,10"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>

            <!-- Контейнер для формы ввода данных -->
            <ContentControl x:Name="UserInfoFormContainer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0"/>
        </Grid>
    </ScrollViewer>

</Page>
