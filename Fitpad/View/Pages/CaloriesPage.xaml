<Page x:Class="Fitpad.View.Pages.CaloriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Fitpad.View.Components"
      Title="Ввод данных пользователя">

    <Grid Margin="20">
        <!-- Дата и день недели -->
        <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14"
                   FontWeight="Bold" Margin="0,10,10,0" Visibility="Collapsed"/>

        <!-- Суточная норма калорий -->
        <TextBlock x:Name="CalorieTextBlock" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="24"
                   FontWeight="Bold" Margin="0,40,0,0" Visibility="Collapsed"/>

        <!-- Форма анкеты -->
        <local:UserInfoForm x:Name="UserInfoForm" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

</Page>
