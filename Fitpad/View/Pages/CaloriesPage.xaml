<Page x:Class="Fitpad.View.Pages.CaloriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблиця калорійності">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <!-- Контейнер для страницы калорий -->
            <StackPanel x:Name="CaloriePageContainer" Visibility="Collapsed">
                <!-- Дата и день недели -->
                <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Right" VerticalAlignment="Top" 
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Суточная норма калорий -->
                <TextBlock x:Name="CalorieTextBlock" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" 
                           Margin="0,20,0,20" Visibility="Collapsed"/>

                <!-- Блок добавления продукта -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Додати продукт:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Width="300" Margin="0,0,0,10">
                        
                        <ComboBox x:Name="ProductSearchBox"
                                  Width="300"
                                  IsEditable="True"
                                  PreviewKeyUp="ProductSearchBox_PreviewKeyUp"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Кількість (г):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="ProductQuantityTextBox" Width="100"/>
                    </StackPanel>

                    <Button Content="Додати" Width="100" HorizontalAlignment="Left" Click="AddProductButton_Click"/>
                </StackPanel>

                <!-- Таблица продуктов -->
                <DataGrid x:Name="ProductsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Margin="0,20,0,0" Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Продукт" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Кількість (г)" Binding="{Binding Quantity}" Width="*"/>
                        <DataGridTextColumn Header="Калорії" Binding="{Binding Calories}" Width="*"/>
                        <DataGridTextColumn Header="Білки (г)" Binding="{Binding Proteins}" Width="*"/>
                        <DataGridTextColumn Header="Жири (г)" Binding="{Binding Fats}" Width="*"/>
                        <DataGridTextColumn Header="Вуглеводи (г)" Binding="{Binding Carbs}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Блок КБЖУ -->
                <StackPanel Margin="0,10,20,0">
                    <TextBlock Text="КБЖУ:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ProteinTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="FatTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="CarbTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Блок питьевого режима -->
                <StackPanel Margin="20,10,0,0">
                    <TextBlock Text="Питний режим:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="WaterTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Блок клетчатки, сахара и соли -->
                <StackPanel Margin="0,10,20,0">
                    <TextBlock Text="Клітковина, цукор і сіль:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="FiberTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SugarTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SaltTextBlock" FontSize="16" Margin="0,5,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Блок рациона за день -->
                <StackPanel Margin="20,10,0,0">
                    <TextBlock Text="Дієта на день:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel x:Name="MealsPanel" Margin="0,10,0,0">
                        <TextBlock Text="Сніданок (06:00 - 09:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="BreakfastTextBlock" Text="-" Margin="10,5,0,10"/>
                        <TextBlock Text="Другий сніданок (09:00 - 11:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SecondBreakfastTextBlock" Text="-" Margin="10,5,0,10"/>
                        <TextBlock Text="Обід (12:00 - 14:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="LunchTextBlock" Text="-" Margin="10,5,0,10"/>
                        <TextBlock Text="Полудень (15:00 - 16:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="AfternoonSnackTextBlock" Text="-" Margin="10,5,0,10"/>
                        <TextBlock Text="Вечеря (18:00 - 20:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="DinnerTextBlock" Text="-" Margin="10,5,0,10"/>
                        <TextBlock Text="Друга вечеря (20:00 - 22:00):" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SecondDinnerTextBlock" Text="-" Margin="10,5,0,10"/>
                        <TextBlock Text="Інший час:" FontSize="16" FontWeight="Bold" Margin="10,5,0,10"/>
                        <TextBlock x:Name="OtherTimeTextBlock" Text="-" Margin="10,5,0,10" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Контейнер для формы анкеты -->
            <ContentControl x:Name="UserInfoFormContainer" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,20,0,0" Visibility="Collapsed"/>

        </Grid>
    </ScrollViewer>
</Page>
