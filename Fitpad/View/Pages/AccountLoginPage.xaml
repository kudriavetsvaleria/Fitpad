<Page x:Class="Fitpad.View.Pages.AccountLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизація">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="350" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="Увійдіть у свій акаунт:"
                       FontSize="20" FontWeight="Bold" Foreground="#007ACC"
                       TextAlignment="Center" Margin="0,-60,0,10"/>

            <Label Content="Логін:" FontSize="14" Foreground="Black" Margin="0,-20,0,3"/>
            <TextBox x:Name="UsernameTextBox" Width="300" Height="30" FontSize="14" Margin="0,0,0,10"/>

            <Label Content="Пароль:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox" Width="300" Height="30" FontSize="14" Margin="0,0,0,10"/>

            <Button Content="Увійти" Width="300" Height="40" Click="LoginButton_Click"
                    Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0"
                    Cursor="Hand" Margin="0,10,0,0"/>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextAlignment="Center"
                       Visibility="Collapsed" Margin="0,10,0,0" FontSize="12"/>

            <TextBlock Text="Немає акаунта?" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <Button Content="Реєстрація" Width="300" Height="40" Click="NavigateToRegistrationPage_Click"
                    Background="#5bc0de" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Page>
