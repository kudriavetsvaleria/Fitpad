<Page x:Class="Fitpad.View.Pages.AccountLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
            <TextBox x:Name="UsernameTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>

            <Label Content="Пароль:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>

            <Button Content="Войти" Width="250" Height="35" Click="LoginButton_Click"
                    Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0"/>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextAlignment="Center" Visibility="Collapsed"
                       Margin="0,10,0,0" FontSize="12"/>

            <TextBlock Text="Нет аккаунта?" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <Button Content="Регистрация" Width="250" Height="35" Click="NavigateToRegistrationPage_Click"
        Background="#5bc0de" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" />

        </StackPanel>
    </Grid>
</Page>
