<Page x:Class="Fitpad.View.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Fitpad.ViewModel.PagesViewModels"
      Title="NewsPage"
      Background="White">

    <Page.DataContext>
        <vm:NewsViewModel />
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView ItemsSource="{Binding News}" Background="Transparent" Grid.Column="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0" CornerRadius="12" Margin="8" Padding="12" Background="#F9F9F9" Effect="{DynamicResource ShadowEffect}">
                            <StackPanel Orientation="Vertical" Width="600">
                                <Image Source="{Binding UrlToImage}" Height="320" Width="580" Stretch="UniformToFill" Margin="0 0 0 10" />
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="Black" Margin="5,10,5,5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#555555" TextWrapping="Wrap" Margin="5,5,5,10" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</Page>
