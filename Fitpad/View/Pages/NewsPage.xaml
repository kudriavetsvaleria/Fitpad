<Page x:Class="Fitpad.View.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Fitpad.ViewModel.PagesViewModels"
      Title="Новини"
      Background="White">

    <Page.DataContext>
        <vm:NewsViewModel />
    </Page.DataContext>

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="10,40,10,10">
            <ListView ItemsSource="{Binding News}" Background="Transparent" HorizontalAlignment="Center">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Center">
                            <Border BorderThickness="0" CornerRadius="12" Margin="8" Padding="12" Background="#F9F9F9" Width="600">
                                <StackPanel Orientation="Vertical">
                                    <Image Source="{Binding UrlToImage}"
                                           Height="320"
                                           Width="580"
                                           Stretch="UniformToFill"
                                           Margin="0 0 0 10"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               Margin="5,10,5,5"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="14"
                                               Foreground="#555555"
                                               TextWrapping="Wrap"
                                               Margin="5,5,5,10"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
