<Page x:Class="Fitpad.View.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Fitpad.ViewModel.PagesViewModels"
      Title="NewsPage">

    <Page.DataContext>
        <vm:NewsViewModel />
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ListView ItemsSource="{Binding News}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="White" BorderThickness="1" CornerRadius="10" Margin="5" Padding="50">
                        <StackPanel Orientation="Vertical" Width="610">
                            <Image Source="{Binding UrlToImage}" Height="370" Width="550" Stretch="UniformToFill" />
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="5,20,5,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" Margin="5,20,5,10" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </ScrollViewer>
</Page>
