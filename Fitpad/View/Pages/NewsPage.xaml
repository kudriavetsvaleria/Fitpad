<Page x:Class="Fitpad.View.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Fitpad.ViewModel.PagesViewModels"
      Title="NewsPage">

    <Page.DataContext>
        <vm:NewsViewModel />
    </Page.DataContext>

    <Grid>
        <ListView ItemsSource="{Binding News}" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <StackPanel Orientation="Vertical" Width="300">
                            <Image Source="{Binding UrlToImage}" Height="150" Width="280" Stretch="UniformToFill" />
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="5,10,5,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" Margin="5,5,5,10" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
