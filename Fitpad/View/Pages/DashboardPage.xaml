<Page x:Class="Fitpad.View.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Background="#FAFAFA"
      Loaded="Page_Loaded">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======= ВЕРХНЯЯ ПАНЕЛЬ KPI + ПРОФІЛЬ ======= -->
        <DockPanel Margin="0,0,0,10" LastChildFill="False">

            <!-- KPI блоки -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <!-- Калорії сьогодні -->
                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Калорії сьогодні" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>

                <!-- Баланс БЖВ -->
                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Баланс БЖВ" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>

                <!-- Прогрес до мети -->
                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Прогрес до мети" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>

                <!-- Вода сьогодні -->
                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Вода сьогодні" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 🧍 Міні-профіль користувача -->
            <Border Background="White"
        CornerRadius="10"
        Padding="10"
        Height="75"
        Width="141"
        Margin="10,0,0,0"
        DockPanel.Dock="Right"
        Cursor="Hand"
        MouseLeftButtonUp="MiniDashboard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <DockPanel>
                    <Ellipse Width="35" Height="35" Fill="#6C63FF" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding MiniDashboard_Name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding MiniDashboard_Level}" FontSize="11" Foreground="#6C63FF"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ======= ОСНОВНА СІТКА ======= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 📈 ЛІНІЙНИЙ ГРАФІК -->
            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Динаміка споживання калорій (тиждень)"
                                   FontSize="13" FontWeight="SemiBold" Margin="5,0,0,6"/>
                        <lvc:CartesianChart x:Name="CaloriesChart"
                                            Height="200"
                                            LegendLocation="None"
                                            DisableAnimations="True"/>
                    </StackPanel>

                    <!-- Легенда -->

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,2">
                        <!-- Додаткова легенда для білків, жирів, вуглеводів -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Ellipse Width="9" Height="9" Fill="#6C63FF" Margin="0,0,5,0"/>
                                <TextBlock Text="Калорії" FontSize="11" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Ellipse Width="9" Height="9" Fill="Blue" Margin="0,0,5,0"/>
                                <TextBlock Text="Білки" FontSize="11" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Ellipse Width="9" Height="9" Fill="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="Жири" FontSize="11" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Ellipse Width="9" Height="9" Fill="Green" Margin="0,0,5,0"/>
                                <TextBlock Text="Вуглеводи" FontSize="11" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Rectangle Width="15" Height="3" Fill="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Норма" FontSize="11" Foreground="#333"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- 🥯 КОЛЬЦЕВА ДІАГРАМА -->
            <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="5,5,0,5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Співвідношення макронутрієнтів (БЖВ)"
                   FontSize="13" FontWeight="SemiBold" Margin="5,0,0,6"/>
                    <lvc:PieChart x:Name="MacroChart"
                      InnerRadius="50"
                      Height="190"
                      LegendLocation="None"
                      DisableAnimations="True"/>

                    <!-- 🟢 Легенда с количеством -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <!-- Білки -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="Blue" Margin="0,0,5,0"/>
                                <TextBlock Text="Білки" FontSize="12"/>
                            </StackPanel>
                            <Border Background="#EEF3FF" CornerRadius="4" Margin="0,10,0,0" Padding="4,1">
                                <TextBlock Text="{Binding MacroProteinsText}" FontSize="11" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Жири -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="Жири" FontSize="12"/>
                            </StackPanel>
                            <Border Background="#FFEFEF" CornerRadius="4" Margin="0,10,0,0" Padding="4,1">
                                <TextBlock Text="{Binding MacroFatsText}" FontSize="11" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Вуглеводи -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="Green" Margin="0,0,5,0"/>
                                <TextBlock Text="Вуглеводи" FontSize="12"/>
                            </StackPanel>
                            <Border Background="#E9F8E9" CornerRadius="4" Margin="0,10,0,0" Padding="4,1">
                                <TextBlock Text="{Binding MacroCarbsText}" FontSize="11" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- 🧾 Таблиця -->
            <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Найчастіше споживані продукти"
                               FontSize="13" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              Height="150" BorderThickness="0" FontSize="12" ItemsSource="{Binding FrequentProducts}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Ккал" Binding="{Binding Calories}" Width="Auto"/>
                            <DataGridTextColumn Header="Білки" Binding="{Binding Protein}" Width="Auto"/>
                            <DataGridTextColumn Header="Жири" Binding="{Binding Fat}" Width="Auto"/>
                            <DataGridTextColumn Header="Вуглеводи" Binding="{Binding Carbs}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 📊 Загальна статистика -->
            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                
                <!-- Загальна статистика користувача -->
                <StackPanel Orientation="Vertical" Margin="10,0,0,0" x:Name="UserStatsPanel">
                    <TextBlock Text="Загальна статистика користувача"
                               FontSize="13" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <!-- Дні активності -->
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="10" Height="10" Fill="#6C63FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatDaysActiveText}"
                   FontSize="12"
                   Foreground="#333"/>
                    </StackPanel>

                    <!-- Збережених страв -->
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="10" Height="10" Fill="Red" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatSavedDishesText}"
                   FontSize="12"
                   Foreground="#333"/>
                    </StackPanel>

                    <!-- Продуктів у базі -->
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="10" Height="10" Fill="Green" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatProductsInBaseText}"
                   FontSize="12"
                   Foreground="#333"/>
                    </StackPanel>
                </StackPanel>

            </Border>
        </Grid>
    </Grid>
</Page>
