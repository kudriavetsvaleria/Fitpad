<Page x:Class="Fitpad.View.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="ProfilePage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Заголовок -->
            <RowDefinition Height="*" />
            <!-- Информация о пользователе -->
            <RowDefinition Height="Auto" />
            <!-- Кнопка выхода -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Личный кабинет"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Информация о пользователе -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <!-- Данные пользователя -->
            <TextBlock Text="Имя пользователя:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUser.Name}" FontSize="16" Margin="0,0,0,10" />

            <TextBlock Text="Email:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUser.Email}" FontSize="16" Margin="0,0,0,10" />

            <!-- Данные анкеты -->
            <TextBlock Text="Пол:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUserInfo.Gender}" FontSize="16" Margin="0,0,0,10" />

            <TextBlock Text="Возраст:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUserInfo.Age}" FontSize="16" Margin="0,0,0,10" />

            <TextBlock Text="Рост:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUserInfo.Height}" FontSize="16" Margin="0,0,0,10" />

            <TextBlock Text="Вес:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUserInfo.Weight}" FontSize="16" Margin="0,0,0,10" />

            <TextBlock Text="Уровень активности:" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding CurrentUserInfo.ActivityLevel}" FontSize="16" Margin="0,0,0,10" />
        </StackPanel>

        <!-- Кнопка выхода -->
        <Button Content="Выйти"
                Foreground="White"
                Background="#D9534F"
                FontSize="16"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Cursor="Hand"
                Width="120"
                Margin="0,10,0,0"
                Click="LogoutButton_Click"
                Grid.Row="2"/>
    </Grid>
</Page>
