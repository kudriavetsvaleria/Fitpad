<Page x:Class="Fitpad.View.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">
    <Grid>
        <StackPanel>
            <TextBlock Text="Личный кабинет" FontWeight="Bold" FontSize="20" />
            <TextBlock Text="Имя пользователя:" />
            <TextBlock Text="{Binding CurrentUser.Username}" />
            <TextBlock Text="Email:" />
            <TextBlock Text="{Binding CurrentUser.Email}" />
            <TextBlock Text="Рост:" />
            <TextBlock Text="{Binding CurrentUser.Height}" />
            <TextBlock Text="Вес:" />
            <TextBlock Text="{Binding CurrentUser.Weight}" />
            <TextBlock Text="Дата рождения:" />
            <TextBlock Text="{Binding CurrentUser.BirthDate, StringFormat='{}{0:dd.MM.yyyy}'}" />
        </StackPanel>
    </Grid>
</Page>
