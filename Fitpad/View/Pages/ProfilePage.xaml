<Page x:Class="Fitpad.View.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Background="#FAFAFA"
      Loaded="Page_Loaded">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======= ВЕРХНЯЯ ПАНЕЛЬ KPI + ПРОФИЛЬ ======= -->
        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <!-- KPI блоки -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Калорії сьогодні" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="1 870 ккал" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="+5 % до мети" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Баланс БЖВ" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="30 / 25 / 45" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="ідеальний баланс" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Прогрес до мети" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="74 %" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="+2 % за тиждень" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="10" Width="135" Height="75" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Вода сьогодні" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="2.3 л" FontSize="17" FontWeight="Bold" Foreground="#6C63FF"/>
                        <TextBlock Text="+0.4 л сьогодні" FontSize="10" Foreground="#23C552"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Мини-профиль справа -->
            <Border Background="White" CornerRadius="10" Padding="10" Height="75" Width="155" Margin="10,0,0,0" DockPanel.Dock="Right">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <DockPanel>
                    <Ellipse Width="35" Height="35" Fill="#6C63FF" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Kot04ka" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Рівень 12" FontSize="11" Foreground="#6C63FF"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ======= ОСНОВНАЯ СЕТКА ======= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 📈 ЛИНЕЙНЫЙ ГРАФИК -->
            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Динаміка споживання калорій (тиждень)" 
                                   FontSize="13" FontWeight="SemiBold" Margin="5,0,0,6"/>
                        <lvc:CartesianChart x:Name="CaloriesChart"
                                            Height="200"
                                            LegendLocation="None"
                                            DisableAnimations="True"/>
                    </StackPanel>

                    <!-- Легенда снизу -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,2">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Rectangle Width="15" Height="3" Fill="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Норма" FontSize="11" Foreground="#333"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Ellipse Width="9" Height="9" Fill="#6C63FF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Фактичне споживання" FontSize="11" Foreground="#333"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 🥯 КОЛЬЦЕВАЯ ДИАГРАММА -->
            <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Співвідношення макронутрієнтів (БЖВ)"
                               FontSize="13" FontWeight="SemiBold" Margin="5,0,0,6"/>
                    <lvc:PieChart x:Name="MacroChart"
                                  InnerRadius="50"
                                  Height="190"
                                  LegendLocation="None"
                                  DisableAnimations="True"/>
                    <!-- Подписи под диаграммой -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Ellipse Width="12" Height="12" Fill="Blue" Margin="0,0,5,0"/>
                            <TextBlock Text="Білки" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Ellipse Width="12" Height="12" Fill="Red" Margin="0,0,5,0"/>
                            <TextBlock Text="Жири" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Ellipse Width="12" Height="12" Fill="Green" Margin="0,0,5,0"/>
                            <TextBlock Text="Вуглеводи" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 🧾 Таблица -->
            <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Найчастіше споживані продукти" 
                               FontSize="13" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              Height="150" BorderThickness="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Ккал" Binding="{Binding Calories}" Width="Auto"/>
                            <DataGridTextColumn Header="Білки" Binding="{Binding Protein}" Width="Auto"/>
                            <DataGridTextColumn Header="Жири" Binding="{Binding Fat}" Width="Auto"/>
                            <DataGridTextColumn Header="Вуглеводи" Binding="{Binding Carbs}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 📊 Загальна статистика -->
            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Загальна статистика користувача" 
                               FontSize="13" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="12" Height="12" Fill="#6C63FF" Margin="0,0,8,0"/>
                        <TextBlock Text="Днів активності: 21"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="12" Height="12" Fill="#FF5C5C" Margin="0,0,8,0"/>
                        <TextBlock Text="Збережених страв: 34"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Width="12" Height="12" Fill="#23C552" Margin="0,0,8,0"/>
                        <TextBlock Text="Продуктів у базі: 58"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
