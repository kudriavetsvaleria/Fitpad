<Page x:Class="Fitpad.View.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#FAFAFA">

    <!-- ======= ОСНОВНАЯ СЕТКА ======= -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок -->
            <RowDefinition Height="*"/>
            <!-- основное содержимое -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <!-- графики -->
            <ColumnDefinition Width="Auto"/>
            <!-- карточка профиля -->
        </Grid.ColumnDefinitions>

        <!-- ======= Заголовок ======= -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="Аналітика харчування"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#222"
                   Margin="5,0,0,15"/>

        <!-- ======= КАРТОЧКА ПРОФИЛЯ (правая верхняя часть) ======= -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                Width="140" Height="140"
                Padding="8"
                CornerRadius="12"
                Background="White"
                VerticalAlignment="Top"
                Margin="15,10,0,0"
                MouseLeftButtonUp="ProfileCard_Click">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="50" Height="50" Stroke="#E0E0E0" StrokeThickness="2" Margin="0,0,0,6">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="pack://application:,,,/Images/profile.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Text="{Binding CurrentUser.Name}" FontSize="13" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentUser.Email}" FontSize="10" Foreground="#777" HorizontalAlignment="Center"/>

                <StackPanel x:Name="ProfileButtons" Orientation="Vertical" Visibility="Collapsed" Margin="0,5,0,0">
                    <Button x:Name="EditButton" Content="Редагувати" Width="90" Height="22" Margin="0,2"
                            FontSize="11" Foreground="White" Background="#5CB85C" BorderThickness="0" Click="EditProfile_Click"/>
                    <Button x:Name="LogoutButton" Content="Вийти" Width="90" Height="22" Margin="0,2"
                            FontSize="11" Foreground="White" Background="#D9534F" BorderThickness="0" Click="LogoutButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======= ГРАФИКИ ======= -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- круговая БЖВ -->
                <RowDefinition Height="Auto"/>
                <!-- линия калорий -->
                <RowDefinition Height="Auto"/>
                <!-- ещё один график -->
            </Grid.RowDefinitions>

            <!-- ==== 1. Баланс БЖВ ==== -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Баланс макронутрієнтів (БЖВ)"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="5,0,0,10"/>
                    <lvc:PieChart x:Name="MacroBalanceChart"
                                  Height="180"
                                  LegendLocation="Right"
                                  InnerRadius="60"/>
                </StackPanel>
            </Border>

            <!-- ==== 2. Калорії, білки, жири, вуглеводи, вода ==== -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10" Margin="0,0,-157,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.25"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,5">
                        <RadioButton GroupName="Range" Content="7 днів" IsChecked="True" Tag="7" Checked="Range_Checked" Margin="0,0,10,0"/>
                        <RadioButton GroupName="Range" Content="30 днів" Tag="30" Checked="Range_Checked" Margin="0,0,10,0"/>
                        <RadioButton GroupName="Range" Content="90 днів" Tag="90" Checked="Range_Checked"/>
                    </StackPanel>

                    <lvc:CartesianChart x:Name="CaloriesChart"
                                        Height="220"
                                        LegendLocation="Right"
                                        Hoverable="True">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Дата"
                                      FontSize="11"
                                      Foreground="#555"
                                      LabelsRotation="15"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Ккал / г / мл"
                                      FontSize="11"
                                      Foreground="#555"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- ==== 3. Можна додати інший графік ==== -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.25"/>
                </Border.Effect>

                <TextBlock Text="(Резерв для майбутнього графіка)" 
                           FontSize="12" Foreground="#999" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Height="100"/>
            </Border>
        </Grid>
    </Grid>
</Page>
