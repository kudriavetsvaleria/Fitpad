<Page x:Class="Fitpad.View.Pages.CalculateNutritionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Fitpad.Converters"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <Page.Resources>
        <local:ButtonColorConverter x:Key="ButtonColorConverter"/>
        <!-- Стиль для полей ввода -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#9a9a9a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="20">
                            <!-- Увеличенное закругление углов -->
                            <ScrollViewer Margin="5" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль для кнопок -->
        <Style x:Key="StylishButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#BDBDBD"/>
            <!-- Серый по умолчанию -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="10" 
                        BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <!-- Зеленый цвет -->
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Стиль для кнопки отмены -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#e93131" Offset="0"/>
                        <GradientStop Color="#e93131" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="10" 
                        BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
        Background="White"
        BorderThickness="0"
        Padding="10"
        Margin="-10,-120,0,0"
        Width="770"
        Height="350"
        CornerRadius="20">

            <DataGrid ItemsSource="{Binding SavedProducts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      AlternationCount="2"
                      HorizontalGridLinesBrush="Transparent"
                      VerticalGridLinesBrush="Transparent"
                      ScrollViewer.CanContentScroll="True"
                      Height="340" 
                      VerticalAlignment="Top"
                      Margin="0,-40,21,0">

                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border CornerRadius="15" Background="{TemplateBinding Background}">
                                        <Grid>
                                            <DataGridCellsPresenter/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E2E8F"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}" 
                                    CornerRadius="15,15,0,0">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Час" Binding="{Binding Time}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <!-- Увеличенный шрифт -->
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                                <!-- Цвет текста -->
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Вага" Binding="{Binding Weight}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Калорії" Binding="{Binding Calories}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Білки" Binding="{Binding Protein}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Жири" Binding="{Binding Fats}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Вуглеводи" Binding="{Binding Carbs}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        

        <StackPanel Grid.Row="1" Grid.Column="0" 
            Orientation="Vertical" 
            HorizontalAlignment="Left"
            Margin="524,-125,0,10">

            <TextBlock x:Name="ProteinDisplayText" FontSize="16" FontWeight="Bold" Foreground="#5C5C5C" 
               Text="{Binding ProteinDisplayText, StringFormat='Білки: {0:F1}'}"
               Margin="0,0,0,0"/>

            <TextBlock x:Name="FatsDisplayText" FontSize="16" FontWeight="Bold" Foreground="#5C5C5C"
               Text="{Binding FatsDisplayText, StringFormat='Жири: {0:F1}'}"
               Margin="0,25,0,0"/>

            <TextBlock x:Name="CarbsDisplayText" FontSize="16" FontWeight="Bold" Foreground="#5C5C5C"
               Text="{Binding CarbsDisplayText, StringFormat='Вуглеводи: {0:F1}'}"
               Margin="0,25,0,0"/>

            <TextBlock x:Name="WaterDisplayText" FontSize="16" FontWeight="Bold" Foreground="#5C5C5C"
               Text="{Binding WaterDisplayText, StringFormat='Вода: {0:F1}'}"
               Margin="0,25,0,0"/>
        </StackPanel>


        <Grid Grid.Row="1" Grid.Column="1"
      VerticalAlignment="Top"
      HorizontalAlignment="Right"
      Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Первая диаграмма (калории) -->
            <lvc:PieChart Grid.Column="0"
                  LegendLocation="None"
                  Series="{Binding CalorieChartSeries}"
                  Width="200"
                  Height="200"
                  Margin="-1300,-170,0,0"/>

            <!-- Вторая диаграмма (вода) -->
            <lvc:PieChart Grid.Column="1"
                  LegendLocation="None"
                  Series="{Binding WaterChartSeries}"
                  Width="200"
                  Height="200"
                  Margin="-820,-170,0,0"/>
        </Grid>





        <StackPanel Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,50,10,0">
            <Border Background="White"
                    BorderBrush="#ccc"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="5" Height="45">
                <TextBox x:Name="SearchBox"
						 Width="260"
						 Height="35"
						 FontSize="16"
						 Padding="5"
						 Background="Transparent"
						 BorderThickness="0"
						 Text="Назва продукту..."
						 Foreground="Gray"
						 GotFocus="SearchTextBox_GotFocus"
						 LostFocus="SearchTextBox_LostFocus"
						 Margin="0,-6,0,-6"/>


            </Border>


            <Border Background="White"
                    BorderBrush="#ccc"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="5"
                    Margin="10,0" Height="45">
                <TextBox x:Name="WeightBox"
                         Width="156"
                         Height="35"
                         FontSize="16"
                         Padding="5"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="Gray"
                         Text="Вага... (г)"
                         GotFocus="WeightBox_GotFocus"
                         LostFocus="WeightBox_LostFocus"
                         Margin="0,-6,0,-6"/>
            </Border>


            <Button Width="45"
                    Height="45"
                    Click="SearchButton_Click"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Padding="5"
                    RenderTransformOrigin="0.50,0.50"
                    Content="🔍">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="#3E2E8F" CornerRadius="14" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="20,10,0,0">
                <TextBlock x:Name="CalorieIntakeText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#5C5C5C"
                           Text="{Binding CalorieDisplayText, Mode=OneWay}"/>


            </StackPanel>
 
        </StackPanel>

        <Grid x:Name="ManualEntryOverlay" Visibility="Collapsed">
            <Border Width="320" Padding="20" Background="White" CornerRadius="22"  Margin="0,30,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Продукт не знайдено." FontWeight="Bold" Foreground="#3E2E8F" FontSize="16" TextAlignment="Center"/>
                    <TextBlock Text="Введіть дані вручну:" FontWeight="Bold" Margin="0,10,0,10" FontSize="14" TextAlignment="Center"/>

                    <!-- Поля ввода -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Калорії:" FontWeight="SemiBold"/>
                        <TextBox x:Name="CaloriesInput" 
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 Text="Введіть калорії..."
                                 Margin="0,5,0,0"
                                 GotFocus="TextBox_GotFocus"
                                 TextChanged="OnInputFieldsChanged"
                                 LostFocus="TextBox_LostFocus"/>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Білки (г):" FontWeight="SemiBold"/>
                        <TextBox x:Name="ProteinInput" 
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 Text="Введіть білки..."
                                 GotFocus="TextBox_GotFocus"
                                 Margin="0,5,0,0"
                                 TextChanged="OnInputFieldsChanged"
                                 LostFocus="TextBox_LostFocus"/>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Жири (г):" FontWeight="SemiBold"/>
                        <TextBox x:Name="FatsInput" 
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 Text="Введіть жири..."
                                 GotFocus="TextBox_GotFocus"
                                 Margin="0,5,0,0"
                                 TextChanged="OnInputFieldsChanged"
                                 LostFocus="TextBox_LostFocus"/>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Вуглеводи (г):" FontWeight="SemiBold"/>
                        <TextBox x:Name="CarbsInput" 
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 Text="Введіть вуглеводи..."
                                 Margin="0,5,0,0"
                                 GotFocus="TextBox_GotFocus"
                                 TextChanged="OnInputFieldsChanged"
                                 LostFocus="TextBox_LostFocus"/>
                    </StackPanel>
                    
                    

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="OkButton"
                                Content="OK"
                                Width="100"
                                Click="OnManualEntryConfirm"
                                Style="{StaticResource StylishButton}"
                                IsEnabled="{Binding ElementName=ManualEntryOverlay, Path=DataContext.CanSave, Mode=OneWay}">
                            <Button.Background>
                                <MultiBinding Converter="{StaticResource ButtonColorConverter}">
                                    <Binding ElementName="CaloriesInput" Path="Text"/>
                                    <Binding ElementName="ProteinInput" Path="Text"/>
                                    <Binding ElementName="FatsInput" Path="Text"/>
                                    <Binding ElementName="CarbsInput" Path="Text"/>
                                </MultiBinding>
                            </Button.Background>
                        </Button>


                        <Button Content="Скасувати" Width="100" Margin="10,0,0,0" Click="OnManualEntryCancel" Style="{StaticResource CancelButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>



    </Grid>

</Page>