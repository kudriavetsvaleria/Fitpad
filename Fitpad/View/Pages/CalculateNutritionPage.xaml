<Page x:Class="Fitpad.View.Pages.CalculateNutritionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">


    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
        Background="White"
        BorderThickness="0"
        Padding="10"
        Margin="-10,-120,0,0"
        Width="770"
        Height="350"
        CornerRadius="20">

            <DataGrid ItemsSource="{Binding SavedProducts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      AlternationCount="2"
                      HorizontalGridLinesBrush="Transparent"
                      VerticalGridLinesBrush="Transparent"
                      ScrollViewer.CanContentScroll="True"
                      Height="340" 
                      VerticalAlignment="Top"
                      Margin="0,-40,21,0">

                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border CornerRadius="15" Background="{TemplateBinding Background}">
                                        <Grid>
                                            <DataGridCellsPresenter/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E2E8F"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}" 
                                    CornerRadius="15,15,0,0">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Час" Binding="{Binding Time}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <!-- Увеличенный шрифт -->
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                                <!-- Цвет текста -->
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Вага" Binding="{Binding Weight}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Калорії" Binding="{Binding Calories}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Білки" Binding="{Binding Protein}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Жири" Binding="{Binding Fats}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Вуглеводи" Binding="{Binding Carbs}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#5C5C5C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>


        <StackPanel Grid.Row="1" Grid.Column="0" 
            Orientation="Vertical" 
            HorizontalAlignment="Left"
            Margin="524,-125,0,10">

            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#5C5C5C" 
               Text="{Binding ProteinDisplayText, StringFormat='Білки: {0:F1}'}"
               Margin="0,0,0,0"/>

            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#5C5C5C"
               Text="{Binding FatsDisplayText, StringFormat='Жири: {0:F1}'}"
               Margin="0,25,0,0"/>

            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#5C5C5C"
               Text="{Binding CarbsDisplayText, StringFormat='Вуглеводи: {0:F1}'}"
               Margin="0,25,0,0"/>

            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#5C5C5C"
               Text="{Binding WaterDisplayText, StringFormat='Вода: {0:F1}'}"
               Margin="0,25,0,0"/>
        </StackPanel>



        <Grid Grid.Row="1" Grid.Column="1"
      VerticalAlignment="Top"
      HorizontalAlignment="Right"
      Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Первая диаграмма (калории) -->
            <lvc:PieChart Grid.Column="0"
                  LegendLocation="None"
                  Series="{Binding CalorieChartSeries}"
                  Width="200"
                  Height="200"
                  Margin="-1300,-170,0,0"/>

            <!-- Вторая диаграмма (вода) -->
            <lvc:PieChart Grid.Column="1"
                  LegendLocation="None"
                  Series="{Binding WaterChartSeries}"
                  Width="200"
                  Height="200"
                  Margin="-820,-170,0,0"/>
        </Grid>





        <StackPanel Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,50,10,0">
            <Border Background="White"
                    BorderBrush="#ccc"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="5" Height="45">
                <TextBox x:Name="SearchBox"
						 Width="260"
						 Height="35"
						 FontSize="16"
						 Padding="5"
						 Background="Transparent"
						 BorderThickness="0"
						 Text="Назва продукту..."
						 Foreground="Gray"
						 GotFocus="SearchTextBox_GotFocus"
						 LostFocus="SearchTextBox_LostFocus"
						 Margin="0,-6,0,-6"/>


            </Border>


            <Border Background="White"
                    BorderBrush="#ccc"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="5"
                    Margin="10,0" Height="45">
                <TextBox x:Name="WeightBox"
                         Width="156"
                         Height="35"
                         FontSize="16"
                         Padding="5"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="Gray"
                         Text="Вага... (г)"
                         GotFocus="WeightBox_GotFocus"
                         LostFocus="WeightBox_LostFocus"
                         Margin="0,-6,0,-6"/>
            </Border>


            <Button Width="45"
                    Height="45"
                    Click="SearchButton_Click"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Padding="5"
                    RenderTransformOrigin="0.50,0.50"
                    Content="🔍">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="#3E2E8F" CornerRadius="14" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="20,10,0,0">
                <TextBlock x:Name="CalorieIntakeText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#5C5C5C"
                           Text="{Binding CalorieDisplayText, Mode=OneWay}"/>


            </StackPanel>


        </StackPanel>
    </Grid>

</Page>