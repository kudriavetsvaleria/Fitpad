<Page x:Class="Fitpad.View.Pages.MyDishesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мої страви">

    <Grid Margin="20">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Назва страви:" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="DishNameBox" Width="400" Height="30"/>

            <TextBlock Text="Час приготування (хв):" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox x:Name="CookingTimeBox" Width="400" Height="30"/>

            <TextBlock Text="Рецепт:" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox x:Name="RecipeBox" Width="400" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>

            <!-- Поиск продуктов -->
            <TextBlock Text="Додати продукт:" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
            <Grid>
                <TextBox x:Name="ProductSearchBox" Width="300" Height="30" TextChanged="ProductSearchBox_TextChanged"/>
                <TextBlock x:Name="PlaceholderTextBlock"
                           Text="Введіть назву продукту"
                           Foreground="Gray"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
            <Button Content="Шукати" Click="SearchProduct_Click" Width="100" />

            <!-- Список продуктов -->
            <ListBox x:Name="ProductListBox" Height="150" Margin="0,10,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" Width="300"/>
                            <Button Content="Видалити" Click="RemoveProduct_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Зберегти страву" Width="200" Height="40" Click="SaveDish_Click" Margin="0,20,0,0"/>

        </StackPanel>
    </Grid>
</Page>
