<Page x:Class="Fitpad.View.Pages.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Recipe Page">

    <Grid>
        <!-- Кнопка "Назад" -->
        <Button Content="←" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackButton_Click" Height="50" Width="50" Margin="10,10,0,0" />

        <!-- ScrollViewer для вертикальной прокрутки -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,70,10,10">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                <!-- Название блюда -->
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"
                           d:Text="Назва рецепта" />

                <!-- Картинка -->
                <Image Source="{Binding Image}" Height="300" Width="300" Margin="0,10,0,20" 
                       d:Source="https://via.placeholder.com/300" Stretch="UniformToFill" />

                <!-- Инструкция -->
                <TextBlock Text="{Binding RecipeDetails}" TextWrapping="Wrap" FontSize="16" FontFamily="Segoe UI" TextAlignment="Justify" Margin="10,0,10,0"
                           d:Text="Це приклад інструкції, яка відображається в дизайнері. Тут можна написати фіктивний текст для зручності редагування." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
