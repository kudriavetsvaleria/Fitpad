<Page x:Class="Fitpad.View.Pages.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Recipe Page">

    <Grid>
        <!-- Кнопка "Назад" -->
        <Button Content="←" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackButton_Click" Height="30" Width="30"/>

        <!-- Основной контент -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Пример данных для дизайнера -->
            <Image Source="{Binding Image}" Height="300" Width="300" Stretch="UniformToFill" Margin="0,0,0,0"
                   d:Source="https://via.placeholder.com/300" />
            <TextBlock Text="{Binding Title}" FontSize="20" HorizontalAlignment="Center"
                       d:Text="Назва рецепта" />
            <TextBlock Text="{Binding RecipeDetails}" TextWrapping="Wrap"
                       d:Text="Це приклад інструкції, яка відображається в дизайнері. Тут можна написати фіктивний текст для зручності редагування." />
        </StackPanel>
    </Grid>
</Page>
