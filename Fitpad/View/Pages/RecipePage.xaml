<Page x:Class="Fitpad.View.Pages.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Recipe Page">

    <Grid Margin="10">
        <!-- Кнопка "Назад" -->
        <Button Content="←" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackButton_Click" Height="50" Width="50" Margin="10,10,0,0" />

        <StackPanel Margin="0,70,0,10" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <!-- Название -->
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"
                       d:Text="Назва рецепта" />

            <!-- Контейнер для ингредиентов и инструкции -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,20,10,0" Height="460">
                <StackPanel>
                    <!-- Картинка и информация о блюде -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding Image}" Height="300" Width="300" Stretch="UniformToFill" Margin="0,0,20,0" Grid.Column="0"
                               d:Source="https://via.placeholder.com/300" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Calories, StringFormat=Калорії: {0} ккал}" FontSize="16" Margin="0,5" />
                            <TextBlock Text="{Binding Protein, StringFormat=Білки: {0} г}" FontSize="16" Margin="0,5" />
                            <TextBlock Text="{Binding Fats, StringFormat=Жири: {0} г}" FontSize="16" Margin="0,5" />
                            <TextBlock Text="{Binding Carbs, StringFormat=Вуглеводи: {0} г}" FontSize="16" Margin="0,5" />
                        </StackPanel>
                    </Grid>

                    <!-- Ингредиенты и инструкция -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                        <StackPanel>
                            <!-- Ингредиенты -->
                            <TextBlock Text="Інгредієнти:" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Ingredients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="16" Margin="10,0" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Инструкция -->
                            <TextBlock Text="Інструкція:" FontSize="20" FontWeight="Bold" Margin="0,20,0,10" />
                            <TextBlock Text="{Binding RecipeDetails}" TextWrapping="Wrap" FontSize="16" FontFamily="Segoe UI" TextAlignment="Justify" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
