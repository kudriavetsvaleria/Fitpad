<Page x:Class="Fitpad.View.Pages.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F7F7FC"
      Title="Recipe Page">

    <Grid Margin="20">
        <!-- Кнопка "Назад" с закругленными углами -->
        <Button Click="BackButton_Click"
                Width="50" Height="50" 
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Background="White" Foreground="#3E2E8F" 
                FontSize="29" FontWeight="Bold"
                BorderBrush="#3E2E8F" BorderThickness="1"
                Cursor="Hand"
                ToolTip="Назад"
                Margin="10,0,0,0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                        <!-- Закругленные углы -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            ←
        </Button>

        <!-- Обернули в ScrollViewer для прокрутки -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,70,0,10">
            <StackPanel HorizontalAlignment="Stretch">
                <!-- Заголовок рецепта с зеленым цветом -->
                <Border Background="#70A93D" Padding="10" CornerRadius="20" Width="720"
                         BorderThickness="1">
                    <TextBlock Text="{Binding Title}" 
                               FontSize="26" 
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Картинка и информация о блюде -->
                <Border BorderBrush="#3E2E8F" BorderThickness="1" CornerRadius="20" Background="White" Padding="10" Margin="0,20,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Квадратная картинка с рамкой -->
                        <Border BorderBrush="#3E2E8F" BorderThickness="1"
                                Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding Image}" Width="250" Height="250" Stretch="UniformToFill"
                                   d:Source="https://via.placeholder.com/250"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                            <TextBlock Text="{Binding Calories, StringFormat=Калорії: {0} ккал}" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,20"/>
                            <TextBlock Text="{Binding Protein, StringFormat=Білки: {0} г}" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,20"/>
                            <TextBlock Text="{Binding Fats, StringFormat=Жири: {0} г}" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,20"/>
                            <TextBlock Text="{Binding Carbs, StringFormat=Вуглеводи: {0} г}" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,20"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Ингредиенты и инструкция -->
                <Border BorderBrush="#3E2E8F" BorderThickness="1" Padding="15" CornerRadius="10" Background="White">
                    <StackPanel>
                        <!-- Ингредиенты -->
                        <TextBlock Text="Інгредієнти:" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Ingredients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="#ECE7FF" CornerRadius="10" Margin="5">
                                        <TextBlock Text="{Binding}" FontSize="18" Foreground="Black" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Инструкция -->
                        <TextBlock Text="Інструкція:" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="0,20,0,10"/>
                        <Border Padding="10" Background="White" CornerRadius="10">
                            <TextBlock Text="{Binding RecipeDetails}" TextWrapping="Wrap" FontSize="18" FontFamily="Segoe UI" Foreground="Black" TextAlignment="Justify"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
