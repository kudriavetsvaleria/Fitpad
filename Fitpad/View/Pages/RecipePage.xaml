<Page x:Class="Fitpad.View.Pages.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Recipe Page">
	<Grid>
		<Button Content="←" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackButton_Click" Height="30" Width="30"/>
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
			<Image Source="{Binding Image}" Height="300" Width="300" Stretch="UniformToFill" />
			<TextBlock Text="{Binding Title}" FontSize="20" />
			<TextBlock Text="{Binding RecipeDetails}" TextWrapping="Wrap" />
		</StackPanel>
	</Grid>
</Page>
