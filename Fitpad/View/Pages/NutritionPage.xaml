<Page x:Class="Fitpad.View.Pages.NutritionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nutrition Page">
    <Grid>
        <ListView ItemsSource="{Binding NutritionCards}" Margin="10">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" MouseDown="Card_MouseDown">
                        <StackPanel Orientation="Vertical" Width="150" Height="220">
                            <Image Source="{Binding Image}" Height="100" Width="150" Stretch="UniformToFill" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="5,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding FormattedTime}" FontSize="12" TextAlignment="Center" Margin="5,0" />
                            <TextBlock Text="{Binding Calories, StringFormat=Калории: {0}}" FontSize="12" TextAlignment="Center" />
                            <TextBlock Text="{Binding Protein, StringFormat=Белки: {0} г}" FontSize="12" TextAlignment="Center" />
                            <TextBlock Text="{Binding Carbs, StringFormat=Углеводы: {0} г}" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
