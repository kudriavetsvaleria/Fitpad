<Page x:Class="Fitpad.View.Pages.NutritionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nutrition Page">

    <Grid>
        <ListView ItemsSource="{Binding NutritionCards}" Margin="10" VerticalAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                        <StackPanel Orientation="Vertical">
                            <Image Source="{Binding Image}" Height="150" Stretch="UniformToFill" />
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="5,0" />
                            <TextBlock Text="{Binding Calories, StringFormat=Калории: {0}}"/>
                            <TextBlock Text="{Binding Protein, StringFormat=Белки: {0} г}"/>
                            <TextBlock Text="{Binding Carbs, StringFormat=Углеводы: {0} г}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
