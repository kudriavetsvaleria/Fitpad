<Page x:Class="Fitpad.View.Pages.NutritionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Nutrition Page">

    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,10,0" Text="Введіть запит" 
                         GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" />
                <Button Content="Пошук" Width="75" Click="OnSearchButtonClick" />
            </StackPanel>

            <Button Content="⟳" Width="50" Height="50" 
                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Background="LightGray" BorderBrush="Gray" 
                    Click="RefreshButton_Click" Margin="692,0,0,0" />

            <!-- Основной контейнер для списка и надписи -->
            <Grid Grid.Row="1">
                <!-- Список рецептов -->
                <ListView x:Name="MyListView" ItemsSource="{Binding NutritionCards}" Margin="10">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" MouseDown="Card_MouseDown">
                                <StackPanel Orientation="Vertical" Width="150" Height="220">
                                    <Image Source="{Binding Image}" Height="100" Width="150" Stretch="UniformToFill" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="5,0" />
                                    <TextBlock Text="{Binding FormattedTime}" FontSize="12" TextAlignment="Center" Margin="5,0" />
                                    <TextBlock Text="{Binding Calories, StringFormat=Калорії: {0}}" FontSize="12" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Protein, StringFormat=Білки: {0} г}" FontSize="12" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Carbs, StringFormat=Вуглеводи: {0} г}" FontSize="12" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Fats, StringFormat=Жири: {0} г}" FontSize="12" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Надпись "Рецептів не знайдено" -->
                <TextBlock Text="Рецептів не знайдено" 
                           Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           FontSize="20" FontWeight="Bold" Foreground="Black" />
            </Grid>
        </Grid>
    </Grid>
</Page>
