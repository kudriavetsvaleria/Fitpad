<Page x:Class="Fitpad.View.Pages.DishesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Fitpad.Converters"
      Title="Мої страви">

    <Page.Resources>
        <local:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Мої страви"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="Black"
                   Margin="10,0,0,10"/>

        <!-- Поле поиска -->
        <Border Grid.Row="1"
                CornerRadius="20"
                Background="White"
                BorderBrush="#ccc"
                BorderThickness="1"
                Padding="5"
                Margin="0,10,10,0">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                         Width="640"
                         Height="35"
                         FontSize="16"
                         Padding="5"
                         Background="Transparent"
                         BorderThickness="0"
                         Text="Пошук страв..."
                         Foreground="Gray"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         VerticalContentAlignment="Center"/>
                <Button Width="35" Height="35" Click="SearchButton_Click"
                        Background="Transparent" BorderThickness="0" Margin="30,0,0,0">
                    <Image Source="pack://application:,,,/Images/search-icon.png"
                           Width="25" Height="25"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Список блюд -->
        <Border Grid.Row="2"
                Height="350"
                CornerRadius="20"
                BorderBrush="#ccc"
                BorderThickness="1"
                Padding="10"
                Margin="4,10,10,10">
            <ListView x:Name="DishesList"
                      ItemsSource="{Binding Dishes}"
                      SelectionMode="Single"
                      SelectionChanged="DishesList_SelectionChanged"
                      Background="White"
                      BorderThickness="0">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <!-- Для кнопки удаления -->
                                </Grid.ColumnDefinitions>

                                <!-- Название блюда -->
                                <TextBlock Text="{Binding Name}"
                           FontSize="18"
                           Padding="10"
                           Grid.Column="0"/>

                                <!-- Кнопка избранного -->
                                <Button Grid.Column="1"
                        Click="ToggleFavorite_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Tag="{Binding}">
                                    <Image Source="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                           Width="25" Height="25"/>
                                </Button>

                                <!-- Кнопка удаления (крестик) -->
                                <Button Grid.Column="2"
                        Click="DeleteDish_Click"
                        Background="Transparent"
                        Foreground="Red"
                        FontSize="20"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Tag="{Binding}"
                        ToolTip="Видалити страву">
                                    ✖
                                </Button>
                            </Grid>

                            <!-- Разделитель -->
                            <Rectangle Width="680"
                       Height="1"
                       Fill="#E0E0E0"
                       Margin="0,5,0,5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Border>

        <!-- Кнопка создания блюда -->
        <Button Grid.Row="3"
                x:Name="CreateDishButton"
                Content="Створити блюдо"
                Width="250"
                Height="50"
                Background="#70A93D"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Command="{Binding ShowConstructorPageCommand}"
                Margin="245,10,0,40">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#3E2E8F" CornerRadius="20" Padding="10,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Page>
