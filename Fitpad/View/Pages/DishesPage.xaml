<Page x:Class="Fitpad.View.Pages.DishesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мої страви">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Заголовок -->
			<RowDefinition Height="Auto"/>
			<!-- Поиск -->
			<RowDefinition Height="*"/>
			<!-- Список блюд -->
			<RowDefinition Height="Auto"/>
			<!-- Кнопка -->
		</Grid.RowDefinitions>

		<!-- 🏷 Заголовок "Мої страви" -->
		<TextBlock Grid.Row="0"
                   Text="Мої страви"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="Black"
                   Margin="10,0,0,10"/>

		<!-- 🔎 Поле поиска (с закругленными углами) -->
		<Border Grid.Row="1"
                CornerRadius="20"
                Background="White"
                BorderBrush="#ccc"
                BorderThickness="1"
                Padding="5"
                Margin="0,10,10,0">
			<StackPanel Orientation="Horizontal">
				<TextBox x:Name="SearchBox"
                         Width="640"
                         Height="35"
                         FontSize="16"
                         Padding="5"
                         Background="Transparent"
                         BorderThickness="0"
                         Text="Пошук страв..."
                         Foreground="Gray"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         VerticalContentAlignment="Center"/>
				<Button Width="35" Height="35" Click="SearchButton_Click" Background="Transparent" BorderThickness="0" Margin="30,0,0,0">
					<Image Source="pack://application:,,,/Images/search-icon.png" Width="25" Height="25"/>
				</Button>
			</StackPanel>
		</Border>

		<!-- 📜 Список блюд с серыми разделителями (ширина 670px) -->
		<Border Grid.Row="2"
                Width="720"
                Height="350"
                CornerRadius="20"
                BorderBrush="#ccc"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,10">
			<ListView x:Name="DishesList"
                      ItemsSource="{Binding Dishes}"
                      Background="White"
                      BorderThickness="0">
				<ListView.ItemTemplate>
					<DataTemplate>
						<StackPanel>
							<!-- Блюдо -->
							<TextBlock Text="{Binding Name}"
                                       FontSize="18"
                                       Padding="10"/>

							<!-- Разделительная линия -->
							<Rectangle Width="680"
                                       Height="1"
                                       Fill="#E0E0E0"
                                       Margin="0,5,0,5"/>
						</StackPanel>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Border>

		<!-- ✅ Кнопка "Створити блюдо" с закругленными углами -->
		<Button Grid.Row="3"
                x:Name="CreateDishButton"
                Content="Створити блюдо"
                Width="250"
                Height="50"
                Background="#70A93D"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Command="{Binding ShowMyDishesCommand}"
                Margin="0,10,0,40">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border Background="#3E2E8F" CornerRadius="15" Padding="10,5">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Button.Template>
		</Button>
	</Grid>
</Page>
