<Page x:Class="Fitpad.View.Pages.AccountRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Поле ввода логина -->
            <StackPanel x:Name="Step1" Visibility="Visible">
                <Label Content="Логин:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="UsernameTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Button Content="Далее" Width="250" Height="35" Click="NextStep_Click" Tag="2"
                        Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Поле ввода почты -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <Label Content="Почта:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="EmailTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Button Content="Далее" Width="250" Height="35" Click="NextStep_Click" Tag="3"
                        Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Поле ввода пароля -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <Label Content="Пароль:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <PasswordBox x:Name="PasswordBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Label Content="Подтвердите пароль:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Button Content="Далее" Width="250" Height="35" Click="NextStep_Click" Tag="4"
                        Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Поле ввода роста -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <Label Content="Рост (см):" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="HeightTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Button Content="Далее" Width="250" Height="35" Click="NextStep_Click" Tag="5"
                        Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Поле ввода веса -->
            <StackPanel x:Name="Step5" Visibility="Collapsed">
                <Label Content="Вес (кг):" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="WeightTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Button Content="Далее" Width="250" Height="35" Click="NextStep_Click" Tag="6"
                        Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Поле ввода даты рождения -->
            <StackPanel x:Name="Step6" Visibility="Collapsed">
                <Label Content="Дата рождения:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <DatePicker x:Name="BirthDatePicker" Width="250" FontSize="14" Margin="0,0,0,10"/>
                <Button Content="Завершить" Width="250" Height="35" Click="RegisterButton_Click"
                        Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Текст ошибки -->
            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextAlignment="Center" Visibility="Collapsed" 
                       Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
