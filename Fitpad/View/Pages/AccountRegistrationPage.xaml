<Page x:Class="Fitpad.View.Pages.AccountRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Fitpad.Converters"
      Title="Реєстрація">

    <Page.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="5" Opacity="0.5" BlurRadius="10"/>
        <local:BooleanConverter x:Key="BooleanConverter"/>
    </Page.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Шаг 1: Ввод логина -->
            <StackPanel x:Name="Step1" Visibility="Visible">
                <Label Content="Логін:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="UsernameTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Далі" Width="120" Height="35" Click="NextStep_Click" Tag="2"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,10,0"
                            IsEnabled="{Binding ElementName=UsernameTextBox, Path=Text.Length, Converter={StaticResource BooleanConverter}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 2: Ввод почты -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <Label Content="Пошта:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <TextBox x:Name="EmailTextBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Назад" Width="120" Height="35" Click="PreviousStep_Click" Tag="1"
                            Background="#D9534F" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Далі" Width="120" Height="35" Click="NextStep_Click" Tag="3"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="{Binding ElementName=EmailTextBox, Path=Text.Length, Converter={StaticResource BooleanConverter}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Шаг 3: Ввод пароля -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <Label Content="Пароль:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <PasswordBox x:Name="PasswordBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <Label Content="Підтвердіть пароль:" FontSize="14" Foreground="Black" Margin="0,0,0,3"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Width="250" Height="30" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Назад" Width="120" Height="35" Click="PreviousStep_Click" Tag="2"
                            Background="#D9534F" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Завершити" Width="120" Height="35" Click="RegisterButton_Click"
                            Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="{Binding ElementName=PasswordBox, Path=Password.Length, Converter={StaticResource BooleanConverter}}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="AccountTextBlock" Text="Є акаунт?" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <Button x:Name="LoginButton" Content="Авторизація" Width="250" Height="35" Click="NavigateToLoginPage_Click"
                    Background="#5bc0de" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>

            <!-- Оверлей сообщения об успешной регистрации -->
            <Grid x:Name="SuccessMessageOverlay" Visibility="Collapsed" Background="#80000000">
                <Border Background="White" CornerRadius="15" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Effect="{DynamicResource DropShadowEffect}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Width="300">
                        <TextBlock Text="Реєстрація успішна!" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" 
                                   Foreground="#007ACC" TextAlignment="Center"/>
                        <Button Content="ОК" Width="150" Height="40" Click="SuccessOkButton_Click"
                                Background="#007ACC" Foreground="White" FontSize="16" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextAlignment="Center" Visibility="Collapsed" 
                       Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
