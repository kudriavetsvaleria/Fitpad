<Page x:Class="Fitpad.View.Pages.AccountRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
	<Grid>
		<!-- Центрирование контента -->
		<Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Логин -->
				<RowDefinition Height="Auto"/>
				<!-- Поле логина -->
				<RowDefinition Height="10"/>
				<!-- Отступ -->
				<RowDefinition Height="Auto"/>
				<!-- Пароль -->
				<RowDefinition Height="Auto"/>
				<!-- Поле пароля -->
				<RowDefinition Height="10"/>
				<!-- Отступ -->
				<RowDefinition Height="Auto"/>
				<!-- Подтверждение пароля -->
				<RowDefinition Height="Auto"/>
				<!-- Поле подтверждения пароля -->
				<RowDefinition Height="10"/>
				<!-- Отступ -->
				<RowDefinition Height="Auto"/>
				<!-- Рост -->
				<RowDefinition Height="Auto"/>
				<!-- Поле роста -->
				<RowDefinition Height="10"/>
				<!-- Отступ -->
				<RowDefinition Height="Auto"/>
				<!-- Вес -->
				<RowDefinition Height="Auto"/>
				<!-- Поле веса -->
				<RowDefinition Height="10"/>
				<!-- Отступ -->
				<RowDefinition Height="Auto"/>
				<!-- Дата рождения -->
				<RowDefinition Height="Auto"/>
				<!-- Поле даты рождения -->
				<RowDefinition Height="20"/>
				<!-- Отступ перед кнопкой -->
				<RowDefinition Height="Auto"/>
				<!-- Кнопка -->
				<RowDefinition Height="Auto"/>
				<!-- Текст ошибки -->
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Поле ввода логина -->
			<Label Content="Логин:" Grid.Row="0" Margin="0,0,0,3" FontSize="14" Foreground="Black"/>
			<TextBox x:Name="UsernameTextBox" Grid.Row="1" Margin="0,0,0,5" Width="250" Height="30" FontSize="14"/>

			<!-- Поле ввода пароля -->
			<Label Content="Пароль:" Grid.Row="3" Margin="0,0,0,3" FontSize="14" Foreground="Black"/>
			<PasswordBox x:Name="PasswordBox" Grid.Row="4" Margin="0,0,0,5" Width="250" Height="30" FontSize="14"/>

			<!-- Поле подтверждения пароля -->
			<Label Content="Подтвердите пароль:" Grid.Row="6" Margin="0,0,0,3" FontSize="14" Foreground="Black"/>
			<PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="7" Margin="0,0,0,5" Width="250" Height="30" FontSize="14"/>

			<!-- Поле ввода роста -->
			<Label Content="Рост (см):" Grid.Row="9" Margin="0,0,0,3" FontSize="14" Foreground="Black"/>
			<TextBox x:Name="HeightTextBox" Grid.Row="10" Margin="0,0,0,5" Width="250" Height="30" FontSize="14"/>

			<!-- Поле ввода веса -->
			<Label Content="Вес (кг):" Grid.Row="12" Margin="0,0,0,3" FontSize="14" Foreground="Black"/>
			<TextBox x:Name="WeightTextBox" Grid.Row="13" Margin="0,0,0,5" Width="250" Height="30" FontSize="14"/>

			<!-- Поле ввода даты рождения -->
			<Label Content="Дата рождения:" Grid.Row="15" Margin="0,0,0,3" FontSize="14" Foreground="Black"/>
			<DatePicker x:Name="BirthDatePicker" Grid.Row="16" Margin="0,0,0,5" Width="250" FontSize="14"/>

			<!-- Кнопка -->
			<Button Content="Зарегистрироваться" Grid.Row="18" Width="250" Height="35" HorizontalAlignment="Center" Click="RegisterButton_Click" Background="#007ACC" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand"/>

			<!-- Текст ошибки -->
			<TextBlock x:Name="ErrorTextBlock" Grid.Row="19" Foreground="Red" TextAlignment="Center" Visibility="Collapsed" Margin="0,10,0,0" FontSize="12"/>
		</Grid>
	</Grid>
</Page>
