<UserControl x:Class="Fitpad.View.Components.UserInfoForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fitpad.View.Components"
             Visibility="Collapsed">

    <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Введіть ваші дані:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Пол -->
        <Label Content="Виберіть вашу стать:"/>
        <ComboBox x:Name="GenderInput" Width="250" Height="30">
            <ComboBoxItem Content="Чоловік"/>
            <ComboBoxItem Content="Жінка"/>
        </ComboBox>

        <!-- Возраст -->
        <Label Content="Введіть ваш вік:"/>
        <TextBox x:Name="AgeInput" Width="250" Height="30"/>

        <!-- Рост -->
        <Label Content="Введіть ваш зріст (см):"/>
        <TextBox x:Name="HeightInput" Width="250" Height="30"/>

        <!-- Вес -->
        <Label Content="Введіть вашу вагу (кг):"/>
        <TextBox x:Name="WeightInput" Width="250" Height="30"/>

        <!-- Уровень активности -->
        <Label Content="Виберіть рівень вашої активності:"/>
        <ComboBox x:Name="ActivityLevelInput" Width="250" Height="30">
            <ComboBoxItem Content="Низька"/>
            <ComboBoxItem Content="Середня"/>
            <ComboBoxItem Content="Висока"/>
        </ComboBox>

        <TextBlock Text="Мета:"/>
        <ComboBox x:Name="PurposeInput" Width="250" Height="30">
            <ComboBoxItem Content="Схуднення"/>
            <ComboBoxItem Content="Збереження маси"/>
            <ComboBoxItem Content="Набір маси"/>
        </ComboBox>
        
        <!-- Кнопка сохранения -->
        <Button Content="Зберегти" Width="120" Height="35" Margin="0,10,0,0"
                Click="SaveButton_Click"/>
    </StackPanel>
</UserControl>
