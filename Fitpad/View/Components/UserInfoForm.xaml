<UserControl x:Class="Fitpad.View.Components.UserInfoForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fitpad.View.Components"
             Background="#F7F7F7">

    <UserControl.Resources>
        
        <!-- Стиль для закругленного ComboBox -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#3E2E8F"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Основное содержимое -->
                                <ToggleButton Name="ToggleButton"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Grid>
                                        <!-- Текст выбора -->
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,30,0"/>
                                        <!-- Стрелочка ▼ -->
                                        <TextBlock Text="▼"
                                           Foreground="Gray"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,10,0"/>
                                    </Grid>
                                </ToggleButton>
                                <!-- Popup с выпадающим списком -->
                                <Popup Name="Popup"
                               Placement="Bottom"
                               StaysOpen="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                                    <Border Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Width="300">
                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Стиль для закругленного TextBox -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#3E2E8F"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Border Background="White"
            Padding="20"
            CornerRadius="15"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Width="390"
            Height="Auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="Заповніть особисті дані"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#3E2E8F"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Пол -->
            <TextBlock Text="Стать:" FontSize="16" FontWeight="SemiBold" Foreground="#5C5C5C"/>
            <ComboBox x:Name="GenderInput" Width="330" Height="40"  Margin="0,5,0,0"
                      Style="{StaticResource RoundedComboBox}">
                            <ComboBoxItem Content="Чоловік"/>
                            <ComboBoxItem Content="Жінка"/>
            </ComboBox>

            <!-- Возраст -->
            <TextBlock Text="Вік:" FontSize="16" FontWeight="SemiBold" Foreground="#5C5C5C" Margin="0,10,0,0"/>
            <TextBox x:Name="AgeInput" Width="330" Height="40" Margin="0,5,0,0" FontSize="18"
                     BorderBrush="#3E2E8F" Background="White" Padding="5"
                     Style="{StaticResource RoundedTextBox}"/>

            <!-- Рост -->
            <TextBlock Text="Зріст (см):" FontSize="16" FontWeight="SemiBold" Foreground="#5C5C5C" Margin="0,10,0,0"/>
            <TextBox x:Name="HeightInput" Width="330" Height="40" Margin="0,5,0,0" FontSize="18"
                     BorderBrush="#3E2E8F" Background="White" Padding="5"
                     Style="{StaticResource RoundedTextBox}"/>

            <!-- Вес -->
            <TextBlock Text="Вага (кг):" FontSize="16" FontWeight="SemiBold" Foreground="#5C5C5C" Margin="0,10,0,0"/>
            <TextBox x:Name="WeightInput" Width="330" Height="40" Margin="0,5,0,0" FontSize="18"
                     BorderBrush="#3E2E8F" Background="White" Padding="5"
                     Style="{StaticResource RoundedTextBox}"/>

            <!-- Уровень активности -->
            <TextBlock Text="Рівень активності:" FontSize="16" FontWeight="SemiBold" Foreground="#5C5C5C" Margin="0,10,0,0"/>
            <ComboBox x:Name="ActivityLevelInput" Width="330" Height="40" Margin="0,5,0,0"
          Style="{StaticResource RoundedComboBox}">
                <ComboBoxItem Content="Низька"/>
                <ComboBoxItem Content="Середня"/>
                <ComboBoxItem Content="Висока"/>
            </ComboBox>


            <!-- Цель -->
            <TextBlock Text="Ціль:" FontSize="16" FontWeight="SemiBold" Foreground="#5C5C5C" Margin="0,10,0,0"/>
            <ComboBox x:Name="GoalInput"
                      Width="330"
                      Height="40"
                      Margin="0,5,0,0"
                      FontSize="16"
                      Style="{StaticResource RoundedComboBox}"
                      SelectedValue="{Binding CurrentUserInfo.Purpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="Схуднення"/>
                <ComboBoxItem Content="Підтримка форми"/>
                <ComboBoxItem Content="Набір маси"/>
            </ComboBox>




            <!-- Кнопка сохранения -->
            <Button Content="Зберегти"
                    Width="300"
                    Height="45"
                    Background="#4CAF50"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,30,0,0"
                    BorderThickness="0"
                    Click="SaveButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="20"
                                            Padding="10"
                                            BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Border>
</UserControl>
