<UserControl x:Class="Fitpad.View.Components.UserInfoForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fitpad.View.Components"
             Visibility="Collapsed">

    <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Введите ваши данные:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Пол -->
        <Label Content="Выберите ваш пол:"/>
        <ComboBox x:Name="GenderInput" Width="250" Height="30">
            <ComboBoxItem Content="Мужской"/>
            <ComboBoxItem Content="Женский"/>
        </ComboBox>

        <!-- Возраст -->
        <Label Content="Введите ваш возраст:"/>
        <TextBox x:Name="AgeInput" Width="250" Height="30"/>

        <!-- Рост -->
        <Label Content="Введите ваш рост (см):"/>
        <TextBox x:Name="HeightInput" Width="250" Height="30"/>

        <!-- Вес -->
        <Label Content="Введите ваш вес (кг):"/>
        <TextBox x:Name="WeightInput" Width="250" Height="30"/>

        <!-- Уровень активности -->
        <Label Content="Выберите уровень вашей активности:"/>
        <ComboBox x:Name="ActivityLevelInput" Width="250" Height="30">
            <ComboBoxItem Content="Низкая"/>
            <ComboBoxItem Content="Средняя"/>
            <ComboBoxItem Content="Высокая"/>
        </ComboBox>

        <TextBlock Text="Цель:"/>
        <ComboBox x:Name="PurposeInput" Width="250" Height="30">
            <ComboBoxItem Content="Похудение"/>
            <ComboBoxItem Content="Сохранение массы"/>
            <ComboBoxItem Content="Набор массы"/>
        </ComboBox>
        
        <!-- Кнопка сохранения -->
        <Button Content="Сохранить" Width="120" Height="35" Margin="0,10,0,0"
                Click="SaveButton_Click"/>
    </StackPanel>
</UserControl>
