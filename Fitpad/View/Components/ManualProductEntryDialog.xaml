<Window x:Class="Fitpad.View.ManualProductEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление продукта" Height="300" Width="250"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Продукт не знайдено." FontWeight="Bold" Foreground="#3E2E8F" Grid.Row="0" Margin="0,0,0,5"/>
		<TextBlock Text="Введіть дані вручну:" FontWeight="Bold" Grid.Row="1" Margin="0,5,0,10"/>

		<StackPanel Grid.Row="2">
			<TextBlock Text="Калорії:"/>
			<TextBox x:Name="CaloriesInput" Width="200"/>
		</StackPanel>

		<StackPanel Grid.Row="3">
			<TextBlock Text="Білки (г):"/>
			<TextBox x:Name="ProteinInput" Width="200"/>
		</StackPanel>

		<StackPanel Grid.Row="4">
			<TextBlock Text="Жири (г):"/>
			<TextBox x:Name="FatsInput" Width="200"/>
		</StackPanel>

		<StackPanel Grid.Row="5">
			<TextBlock Text="Вуглеводи (г):"/>
			<TextBox x:Name="CarbsInput" Width="200"/>
		</StackPanel>

		<StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
			<Button Content="OK" Width="90" Background="#4CAF50" Foreground="White" Click="OnOkClick"/>
			<Button Content="Скасувати" Width="90" Background="#D64545" Foreground="White" Margin="10,0,0,0" Click="OnCancelClick"/>
		</StackPanel>
	</Grid>
</Window>
