<Window x:Class="Fitpad.View.ManualProductEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ручне введення продукту" Height="400" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Назва продукту:" FontWeight="Bold"/>
        <TextBox x:Name="ProductNameText" IsReadOnly="True" Margin="0,5,0,10"/>

        <TextBlock Text="Вага (г):" FontWeight="Bold"/>
        <TextBox x:Name="WeightText" IsReadOnly="True" Margin="0,5,0,10"/>

        <TextBlock Text="Калорії:"/>
        <TextBox x:Name="CaloriesInput" Margin="0,5,0,5"/>

        <TextBlock Text="Білки:"/>
        <TextBox x:Name="ProteinInput" Margin="0,5,0,5"/>

        <TextBlock Text="Жири:"/>
        <TextBox x:Name="FatsInput" Margin="0,5,0,5"/>

        <TextBlock Text="Вуглеводи:"/>
        <TextBox x:Name="CarbsInput" Margin="0,5,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Зберегти" Width="100" Margin="5" Background="#6C63FF" Foreground="White" Click="SaveButton_Click"/>
            <Button Content="Скасувати" Width="100" Margin="5" Background="#ddd" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
